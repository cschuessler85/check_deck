# Vorlage fuer die Konfiguration (lokale Entwicklung und Produktion).
# Diese Datei nach ".env" kopieren und echte Werte eintragen.
# ACHTUNG: ".env" wird NICHT versioniert (siehe .gitignore) und darf
# niemals echte Zugangsdaten ins Repository schreiben.

APP_ENV=development
APP_DEBUG=1

DB_HOST=127.0.0.1
DB_NAME=dlrg_schwimmen
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME

ALLOW_SETUP_PASSWORD=0
ADMIN_SETUP_PASSWORD=
AUDIT_INCLUDE_REQUEST_HASHES=0
