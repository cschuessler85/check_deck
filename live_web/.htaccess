<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        <IfModule mod_access_compat.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|env|ini|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        <IfModule mod_access_compat.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </IfModule>
</FilesMatch>